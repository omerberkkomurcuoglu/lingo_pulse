# Lingo Pulse - Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

PORT=3001

# Google Gemini API Key for AI explanations, quiz generation, and chat
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration (e.g., Docker container)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=lingo_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# API Base URLs
API_URL=http://localhost:3001
API_URL_MOBILE=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_LAN_API_URL=http://localhost:3001

